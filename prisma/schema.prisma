// Prisma schema for Feria Inventario: inventory tracker for a market stall.
// Every InventoryItem belongs to exactly one Feria, so items from different
// fairs never mix.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A single fair/market day. The root of tenant isolation: every item hangs
/// off feriaId.
model Feria {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems InventoryItem[]

  @@index([date])
}

/// An article for sale at the fair, scoped to one Feria.
model InventoryItem {
  id         String    @id @default(cuid())
  feriaId    String
  feria      Feria     @relation(fields: [feriaId], references: [id], onDelete: Cascade)
  name       String
  photoData  Bytes? // foto guardada en la base de datos (no en disco, para que persista en hosting serverless)
  photoMime  String? // ej. "image/jpeg"
  price      Decimal   @default(0)
  sellerName String // quién lo puso a la venta (una de las chicas)
  sold       Boolean   @default(false)
  soldAt     DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([feriaId])
  @@index([feriaId, sold])
  @@index([feriaId, sellerName])
}
